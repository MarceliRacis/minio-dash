# ── MinIO ────────────────────────────────────────────────────────────────────
# Endpoint of your MinIO instance (with or without https://)
# Examples:
#   MINIO_ENDPOINT=s3.example.com
#   MINIO_ENDPOINT=https://s3.example.com
#   MINIO_ENDPOINT=http://localhost:9000   ← disables TLS verification
MINIO_ENDPOINT=https://s3.example.com

# ── Session & Security ───────────────────────────────────────────────────────
# SESSION_BACKEND chooses where S3 credentials are stored:
#   jwt   (default)  - Stateless. Credentials are encrypted and sent in JWT cookie.
#   redis            - Stateful. Credentials are stored in Redis.
SESSION_BACKEND=jwt

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: if not set, a random secret is generated on every startup.
SECRET_KEY=changeme

# Encryption key for S3 credentials (required for JWT backend) — generate with:
#   python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=changeme-encryption-key

# Redis URL — required only if SESSION_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# ── App ──────────────────────────────────────────────────────────────────────
# HTTP port to listen on
PORT=7474

# Public URL of the dashboard (shown in startup banner, used in share links)
WEBUI_HOST=https://minio-dash.example.com

# ── Gunicorn ─────────────────────────────────────────────────────────────────
# Number of worker processes
# Recommended: 2-4 for single-core VPS, (2 * CPU cores) + 1 for larger machines
GUNICORN_WORKERS=2

# Number of threads per worker
GUNICORN_THREADS=1
