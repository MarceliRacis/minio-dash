# ── MinIO ────────────────────────────────────────────────────────────────────
# Endpoint of your MinIO instance (with or without https://)
MINIO_ENDPOINT=https://s3.example.com

# ── App ──────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random secret is generated on every startup (sessions won't survive restarts)
SECRET_KEY=changeme

# HTTP port to listen on
PORT=7474

# Public URL of the dashboard (shown in startup banner)
WEBUI_HOST=https://minio-dash.example.com

# ── Gunicorn ─────────────────────────────────────────────────────────────────
# Number of worker processes (default: 2)
GUNICORN_WORKERS=2

# Number of threads per worker (default: 1)
GUNICORN_THREADS=1
