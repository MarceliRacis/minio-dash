# ── MinIO ────────────────────────────────────────────────────────────────────
# Endpoint of your MinIO instance (with or without https://)
# Examples:
#   MINIO_ENDPOINT=s3.example.com
#   MINIO_ENDPOINT=https://s3.example.com
#   MINIO_ENDPOINT=http://localhost:9000   ← disables TLS verification
MINIO_ENDPOINT=https://s3.example.com

# ── App ──────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: if not set, a random secret is generated on every startup
#          and all sessions will be invalidated on each container restart
SECRET_KEY=changeme

# HTTP port to listen on
PORT=7474

# Public URL of the dashboard (shown in startup banner, used in share links)
WEBUI_HOST=https://minio-dash.example.com

# ── Gunicorn ─────────────────────────────────────────────────────────────────
# Number of worker processes
# Recommended: 2-4 for single-core VPS, (2 * CPU cores) + 1 for larger machines
GUNICORN_WORKERS=2

# Number of threads per worker
# Increase if you have many concurrent users but limited CPU
GUNICORN_THREADS=1
